<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Libs Include="libs\*.dll" Exclude="libs\System.*.dll" />

    <Reference Include="@(Libs)">
      <HintPath>%(Libs.FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuildMoveDll" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <DedicatedTargetDir>C:\Program Files (x86)\Steam\steamapps\common\Puck Dedicated Server\Plugins\Powerups</DedicatedTargetDir>
      <ClientTargetDir>C:\Program Files (x86)\Steam\steamapps\common\Puck\Plugins\Powerups</ClientTargetDir>
    </PropertyGroup>

    <MakeDir Directories="$(DedicatedTargetDir)" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Puck Dedicated Server')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DedicatedTargetDir)" OverwriteReadOnlyFiles="true" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Puck Dedicated Server')" />

    <MakeDir Directories="$(ClientTargetDir)" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Puck')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ClientTargetDir)" OverwriteReadOnlyFiles="true" Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Puck')" />
    
    <Message Importance="high" Text="Copied $(AssemblyName).dll to installed Puck server/client plugin folders when present" />
  </Target>

</Project>
